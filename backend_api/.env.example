# Adhera backend configuration. Copy to .env (gitignored) and fill in values.
# Every key below is read by the code; anything else in .env is ignored.

# --- Database -----------------------------------------------------------------
# SQLite (backend_api/adhera.db) is the default for local development.
USE_SQLITE=true
# Set DATABASE_URL to use PostgreSQL instead (takes priority over USE_SQLITE):
# DATABASE_URL=postgresql+asyncpg://adhera_user:adhera_password@localhost:5432/adhera
# Or set USE_SQLITE=false and provide the parts:
POSTGRES_USER=adhera_user
POSTGRES_PASSWORD=adhera_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=adhera

# --- Prescription label scanning (Google Cloud Vision) ------------------------
# Service account JSON path (relative to backend_api/ or absolute) or API key.
GOOGLE_APPLICATION_CREDENTIALS=secrets/google-credentials.json
GOOGLE_CLOUD_VISION_API_KEY=

# --- Drug-name normalization (RxNorm) -----------------------------------------
# Label photos never leave the backend; only the drug name is looked up.
# Lookup strategy: api (NIH RxNav) | local (JSON file) | both (local, then API)
RXNORM_LOOKUP_MODE=both
RXNORM_ALLOWED_TTYS=SCD,SBD,IN,BN
# Optional local RxNorm names JSON; see datasets/rxnorm_names.sample.json.
RXNORM_LOCAL_PATH=
RXNORM_API_TIMEOUT_SECONDS=4.0

# --- Pill identification (DINOv2 embeddings) ----------------------------------
# Torch device: mps | cuda | cpu. Leave blank to auto-detect.
PILL_EMBEDDING_DEVICE=
# Load pill models at startup instead of on first request.
PRELOAD_PILL_MODELS=false

# --- Loose-pill detection (/pills/analyze) ------------------------------------
# YOLO checkpoint. Blank uses backend_api/runs/pill_model/weights/best.pt;
# the endpoint returns 503 if the file is absent.
PILL_DETECTION_MODEL_PATH=
PILL_SEGMENTATION_MIN_CONFIDENCE=0.4

# --- Adhera video verification ------------------------------------------------
# Defaults use runs/official_blue_pm/corrected_batch_01/. Missing models return 503.
# OFFICIAL_PILL_CHECKPOINT=
# OFFICIAL_COMPARTMENT_CHECKPOINT=
OFFICIAL_VIDEO_DEVICE=cpu

# --- Development only ---------------------------------------------------------
# Allow a known account to sign in with a blank password. Never enable in production.
ALLOW_PASSWORDLESS_LOGIN=false
