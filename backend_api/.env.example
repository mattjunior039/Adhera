USE_SQLITE=true

# Optional explicit DB URLs (leave blank for SQLite local development).
# DATABASE_URL=postgresql+asyncpg://pillbox_user:pillbox_password@localhost:5432/pillbox
# SYNC_DATABASE_URL=postgresql+psycopg://pillbox_user:pillbox_password@localhost:5432/pillbox

POSTGRES_USER=pillbox_user
POSTGRES_PASSWORD=pillbox_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pillbox

# Optional Google Cloud Vision credentials path.
# Local example: ./secrets/google-credentials.json
# Docker example: /app/secrets/google-credentials.json
GOOGLE_APPLICATION_CREDENTIALS=./secrets/google-credentials.json

# Optional local SIG normalization model endpoint (used only as a post-processor).
LOCAL_SIG_LLM_ENDPOINT=
LOCAL_SIG_LLM_MODEL=llama3:8b
LOCAL_FIELD_LLM_MAX_CHARS=6000

# RxNorm lookup strategy: local | api | both
RXNORM_LOOKUP_MODE=both

# Restrict RxNorm term types used by resolver.
RXNORM_ALLOWED_TTYS=SCD,SBD,IN,BN

# Optional path to a local RxNorm JSON file containing names (+ optional rxcui fields).
RXNORM_LOCAL_PATH=

# RxNorm API timeout in seconds.
RXNORM_API_TIMEOUT_SECONDS=4.0
